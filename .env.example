# Copy to .env (never commit .env). Get a free key at https://data.gov.in -> Register -> My Account -> API key
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# MongoDB for user history. Use an Atlas connection string here when deploying.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=crop_advisor
# Set true when hosting behind HTTPS. Local http://127.0.0.1 uses false.
SESSION_COOKIE_SECURE=false
